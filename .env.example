# ============ DATABASE ============
DATABASE_URL="postgresql://user:password@localhost:5432/businessmillion"

# ============ NEXT AUTH ============
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-generate-with-openssl-rand-base64-32"

# ============ ASAAS API ============
ASAAS_API_KEY="your-asaas-api-key"
ASAAS_API_URL="https://api.asaas.com/v3"
ASAAS_WEBHOOK_SECRET="your-webhook-secret"

# ============ BRASIL API ============
BRASIL_API_URL="https://brasilapi.com.br/api"

# ============ CARTÃO CNPJ (CNPJá) ============
# Emite o Comprovante de Inscrição e de Situação Cadastral em PDF pela Receita.
# Sem esta chave o botão "Baixar Cartão CNPJ" responde 503 e orienta o usuário a
# baixar o comprovante no site da Receita e anexá-lo. Chave em https://cnpja.com.
# Cada emissão consome 1 crédito da conta.
CNPJA_API_KEY=""

# ============ CRON ============
CRON_SECRET="generate-with-openssl-rand-base64-32"

# ============ SECURITY ============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============ EMAIL (FUTURE) ============
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# ============ FRONTEND ============
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Business Million"
NEXT_PUBLIC_ASAAS_WEBHOOK_URL="https://yourdomain.com/api/webhooks/asaas"

# ============ ENVIRONMENT ============
NODE_ENV="development"

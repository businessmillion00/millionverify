generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexão pooled (PgBouncer): é ela que as funções serverless usam. Sem pool,
  // um pico de tráfego abre conexão demais e o banco recusa.
  url       = env("DATABASE_URL")
  // Conexão direta: o pooler roda em transaction mode, que quebra prepared
  // statements — migration e `db push` precisam falar direto com o Postgres.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============ USUARIOS E AUTENTICACAO ============

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerified         DateTime?
  name                  String?
  passwordHash          String?
  role                  UserRole  @default(USER)

  // Dados de perfil
  cpfCnpj               String?
  phone                 String?
  avatar                String?

  // Dados Asaas
  asaasCustomerId       String?   @unique

  // Tokens e limite
  tokenBalance          Int       @default(0)
  monthlyTokenLimit     Int       @default(100)

  // Tokens de SMS, em CENTAVOS de token (100 = 1 token SMS = R$ 1). Inteiro
  // de propósito: os preços têm meio token (Instagram custa 1,5) e Float
  // acumularia erro na comparação `>=` da trava de débito. Só entra por
  // conversão de tokens de site (lib/sms/conversion.ts), nunca por PIX.
  smsBalanceCents       Int       @default(0)

  // Status
  isActive              Boolean   @default(true)
  isVerified            Boolean   @default(false)

  // Timestamps
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastLoginAt           DateTime?

  // Relações
  accounts              Account[]
  sessions              Session[]
  sites                 Site[]
  tokenTransactions     TokenTransaction[]
  payments              Payment[]
  auditLogs             AuditLog[]
  notificationSettings  NotificationSettings?
  affiliateStats        AffiliateStats?
  smsActivations        SmsActivation[]
  smsWalletTransactions SmsWalletTransaction[]

  @@index([email])
  @@index([asaasCustomerId])
  @@index([createdAt])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ TOKENS E FATURAMENTO ============

model TokenTransaction {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              TokenTransactionType
  amount            Int
  description       String

  // Referência para pagamento associado
  paymentId         String?
  payment           Payment?              @relation(fields: [paymentId], references: [id])

  balanceBefore     Int
  balanceAfter      Int

  metadata          Json?
  createdAt         DateTime              @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Payment {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dados Asaas
  asaasPaymentId      String?           @unique
  asaasStatus         String            @default("pending")

  amount              Float
  tokensGranted       Int
  description         String

  // Transação PIX
  pixKey              String?
  pixQrCode           String?           @db.Text
  pixExpiresAt        DateTime?

  // Status
  status              PaymentStatus     @default(PENDING)
  paidAt              DateTime?

  // Tentativas e logs
  attemptCount        Int               @default(0)
  lastAttemptAt       DateTime?
  errorLog            String?           @db.Text

  // Relações
  tokenTransactions   TokenTransaction[]
  metadata            Json?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
  @@index([asaasPaymentId])
  @@index([status])
  @@index([createdAt])
}

// ============ NUMEROS PARA SMS (revenda do sms24h) ============

/// Movimento dos tokens de SMS. Mesmas regras do TokenTransaction:
/// `amountCents` é SEMPRE positivo e a direção vem do `type`
/// (CONVERSION/REFUND creditam, PURCHASE debita).
model SmsWalletTransaction {
  id                  String                    @id @default(cuid())
  userId              String
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type                SmsWalletTransactionType
  amountCents         Int
  description         String

  // Compra de número (PURCHASE) ou devolução (REFUND): a ativação de origem.
  // CONVERSION não tem origem aqui: o lado dos tokens de site fica no
  // TokenTransaction do mesmo instante, com type CONVERSION.
  activationId        String?
  activation          SmsActivation?            @relation(fields: [activationId], references: [id])

  balanceBeforeCents  Int
  balanceAfterCents   Int

  metadata            Json?
  createdAt           DateTime                  @default(now())

  @@index([userId])
  @@index([activationId])
  @@index([createdAt])
}

/// Um número alugado no sms24h para receber o SMS de um serviço.
///
/// Ciclo: REQUESTING (saldo já debitado, número ainda não pedido ao provedor)
/// → WAITING_CODE → CODE_RECEIVED → COMPLETED. Sai por CANCELLED (o usuário
/// desistiu), EXPIRED (o prazo venceu sem SMS) ou FAILED (o provedor não
/// entregou número). Sem código recebido, o valor volta para a carteira e
/// `refundedCents` registra quanto — é a trava que impede devolver duas vezes.
model SmsActivation {
  id                    String               @id @default(cuid())
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  service               SmsService
  status                SmsActivationStatus  @default(REQUESTING)

  // Id da ativação no sms24h. Nulo enquanto REQUESTING; único depois.
  providerActivationId  String?              @unique
  // Número com DDI, como o provedor devolve (ex.: 5543999999999).
  phone                 String?

  // Preço cobrado do usuário e custo pago ao provedor (quando conhecido), em centavos.
  priceCents            Int
  costCents             Int?
  refundedCents         Int                  @default(0)

  // Último código recebido. Um "pedir outro SMS" sobrescreve.
  code                  String?
  codeReceivedAt        DateTime?
  retryCount            Int                  @default(0)

  // Prazo para o SMS chegar. Vencido sem código, o número é cancelado e o
  // valor devolvido (lib/sms/activation.ts).
  expiresAt             DateTime
  lastCheckedAt         DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?

  errorLog              String?              @db.Text
  metadata              Json?

  walletTransactions    SmsWalletTransaction[]

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, expiresAt])
  @@index([createdAt])
}

// ============ SITES GERADOS ============

model Site {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Informações
  name                String
  description         String?
  cnpj                String
  companyName         String

  // Domínio
  subdomain           String    @unique
  customDomain        String?   @unique

  // Contato exibido no site
  phone               String?
  email               String?

  // Configurações
  theme               Json      @default("{\"bgColor\": \"#121212\", \"accentColor\": \"#F59E0B\"}")

  // ── Verificação de domínio no Meta ──
  // Dois métodos alternativos oferecidos pela Meta:
  //  metaTag        → injetada no <head> do site (instantâneo)
  //  verificationTxt→ registro TXT na zona DNS do domínio (5-15 min)
  // Por isso o TXT NÃO é conferido no HTML: o health check resolve DNS.
  metaTag             String?   @db.Text
  metaTagVerified     Boolean   @default(false)
  metaTagLastCheckedAt DateTime?

  verificationTxt     String?   @db.Text
  verificationTxtVerified Boolean @default(false)
  verificationTxtLastCheckedAt DateTime?

  /// Último diagnóstico completo: latência, status HTTP, tags encontradas.
  lastDiagnostic      Json?

  // ── Provisionamento ──
  buildStatus         SiteBuildStatus @default(READY)
  buildStartedAt      DateTime?
  buildCompletedAt    DateTime?
  buildError          String?   @db.Text

  // Conteúdo do site + payload bruto da Receita (CNAEs, endereço, capital…)
  content             Json      @default("{}")
  registryData        Json?

  // Comprovante oficial que o próprio usuário baixou da Receita e subiu aqui.
  cnpjDocumentUrl     String?
  cnpjDocumentAt      DateTime?

  // Status
  isPublished         Boolean   @default(true)
  isDeleted           Boolean   @default(false)

  // ── Vida útil ──
  // O site não é permanente: passado este instante ele sai do ar (as consultas
  // filtram por `expiresAt`) e a rotina de expiração o exclui.
  //
  // `createSite` SEMPRE grava o valor a partir de SITE_LIFETIME_DAYS
  // (lib/constants.ts). O default no banco existe para preencher as linhas que
  // já existiam quando a coluna nasceu — sem ele o `db push` recusaria a coluna
  // NOT NULL — e dá 7 dias, contados do deploy, aos sites antigos.
  expiresAt           DateTime  @default(dbgenerated("(now() + '7 days'::interval)"))

  // Analytics
  viewsCount          Int       @default(0)
  lastViewedAt        DateTime?

  // Timestamps
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, subdomain])
  @@index([userId])
  @@index([subdomain])
  @@index([createdAt])
  // A rotina de expiração varre por `expiresAt <= agora` e as páginas públicas
  // filtram por `expiresAt > agora`.
  @@index([expiresAt])
}

// ============ AUDITORIA ============

model AuditLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  action        String
  resource      String
  resourceId    String

  changes       Json?
  ipAddress     String?
  userAgent     String?

  status        String   @default("success")
  errorMessage  String?

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============ NOTIFICACOES ============

model NotificationSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailOnPayment    Boolean  @default(true)
  emailOnSiteUpdate Boolean  @default(true)
  emailNewsletter   Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============ PROGRAMA DE AFILIADOS ============

model AffiliateStats {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  referralCode      String   @unique
  totalReferrals    Int      @default(0)
  totalEarnings     Float    @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============ ENUMS ============

enum UserRole {
  USER
  ADMIN
}

enum TokenTransactionType {
  PURCHASE
  REFUND
  BONUS
  USAGE
  // Tokens de site trocados por tokens de SMS (débito). Tipo próprio para o
  // extrato não confundir a troca com um site publicado.
  CONVERSION
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum SmsService {
  FACEBOOK
  WHATSAPP
  TELEGRAM
  INSTAGRAM
  GOOGLE
}

enum SmsActivationStatus {
  REQUESTING
  WAITING_CODE
  CODE_RECEIVED
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

enum SmsWalletTransactionType {
  CONVERSION
  PURCHASE
  REFUND
}

enum SiteBuildStatus {
  QUEUED
  BUILDING
  READY
  FAILED
}
